OPENROUTER_PRIMARY_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODELS=cohere/north-mini-code:free,nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_TIMEOUT=60
OPENROUTER_API_KEY=sk-or-v1-...........
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_RETRIES=2
AGENT_MAX_ROUNDS=20
#OPENROUTER_ENABLE_FALLBACKS=1
APP_URL=http://localhost:8000

# SQLite file. In Docker this must live on a mounted volume (see docker-compose.yml).
DATABASE_URL=sqlite:////data/workbench.db

# Demo identities accepted in the X-Demo-User header (NOT real authentication).
DEMO_USERS=alice,bob
# Only needed if the UI is hosted on a different origin than the API.
CORS_ORIGINS=
LOG_LEVEL=INFO
# 1 lets the UI run pytest on the server; set 0 on any shared deployment.
ENABLE_TEST_RUNNER=1


NVIDIA_API_KEY=nvapi-.........
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash